# Copy to a secret-managed deployment environment. Never commit real values.
APP_IMAGE=ghcr.io/your-org/codex-gateway
APP_IMAGE_DIGEST=sha256:replace-with-published-image-digest
HTTP_PORT=3000
POSTGRES_USER=gateway
POSTGRES_PASSWORD=replace-with-generated-database-password
POSTGRES_DB=gateway
REDIS_PASSWORD=replace-with-generated-redis-password
SESSION_SECRET=replace-with-at-least-32-random-bytes
GATEWAY_AES_KEY=replace-with-at-least-32-random-bytes
SESSION_COOKIE_TRUSTED_URL=https://gateway.example.com
TRUSTED_PROXIES=10.0.0.10/32
OBJECT_STORE_ENDPOINT=https://objects.example.com
OBJECT_STORE_BUCKET=gateway-files
OBJECT_STORE_REGION=us-east-1
OBJECT_STORE_ACCESS_KEY_ID=replace-with-object-store-access-key
OBJECT_STORE_SECRET_ACCESS_KEY=replace-with-object-store-secret-key
NODE_NAME=gateway-1
TZ=UTC
