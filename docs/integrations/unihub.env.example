# Public product UI + identity proof. Disabled unless explicitly enabled.
UNIHUB_PRODUCT_ENABLED=false
UNIHUB_PRODUCT_PUBLIC_ORIGIN=https://unihub.example.com
# Trusted proof endpoint on the same host/private network. Never sent to browser.
UNIHUB_PRODUCT_API_ORIGIN=http://127.0.0.1:8088
UNIHUB_PRODUCT_CLIENT_ID=llmrouter-web
UNIHUB_PRODUCT_REDIRECT_URI=https://llmrouter.example.com/unihub
UNIHUB_PRODUCT_MODELS='["your-published-model"]'

# Trusted model gateway: opt in after rate, identity and funding acceptance.
UNIHUB_PLATFORM_ENABLED=false
UNIHUB_ORIGIN=http://127.0.0.1:8088
# Supply an independent secret through deployment secret storage, never UI.
UNIHUB_MODEL_SERVICE_TOKEN=
UNIHUB_ROUTING_PRINCIPAL_ID=1
UNIHUB_ROUTING_GROUP=platform
UNIHUB_MAX_INPUT_TOKENS=65536
UNIHUB_MAX_OUTPUT_TOKENS=8192
UNIHUB_MAX_BODY_BYTES=32768
# Public rate IDs only. Each model/asset must have one unambiguous published rate.
UNIHUB_MODEL_ASSET_RATE_IDS='{"CREDIT/6":{"your-published-model":"credit-rate-v1"},"CNY/6":{"your-published-model":"cash-rate-v1"}}'
